# Copy to backend/.env and fill in your values. backend/.env is gitignored.

FASTPHENO_BASE_URL=http://localhost:8000
FASTPHENO_SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated emails allowed to sign in. Leave empty to allow any email (dev only).
# FASTPHENO_ALLOWED_EMAILS=you@utoronto.ca,labmate@utoronto.ca

FASTPHENO_PIN_MINUTES=15

# --- Email delivery ---
# Dev (default): PIN shows on login page + terminal, no inbox needed.
FASTPHENO_DEV_PRINT_PINS=1

# Real email: set DEV_PRINT_PINS=0 and fill in SMTP below.
# FASTPHENO_DEV_PRINT_PINS=0

# Gmail example (use an app password: https://myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=1
# SMTP_USE_SSL=0
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM=FastPheno <you@gmail.com>

# Outlook / Microsoft 365 (U of T mail.utoronto.ca uses this tenant)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USE_TLS=1
# SMTP_USE_SSL=0
# SMTP_USER=you@mail.utoronto.ca
# SMTP_PASSWORD=your-password-or-app-password
# SMTP_FROM=FastPheno <you@mail.utoronto.ca>
#
# U of T often disables SMTP basic auth (error 5.7.139). If login fails, ask IT to enable
# SMTP AUTH for your mailbox, use Gmail with an app password, or for local dev:
#   FASTPHENO_DEV_PRINT_PINS=1
#   FASTPHENO_SMTP_FALLBACK_DEV=1   # default on localhost — show PIN if SMTP fails
