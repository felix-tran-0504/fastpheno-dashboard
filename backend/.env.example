# Copy to backend/.env and fill in values (backend/.env is gitignored).

# --- Local paths ---
# FASTPHENO_DATA_DIR=/absolute/path/to/data/fastpheno

# Local mirror of selected server folders (prep scripts read this as III_db_final root)
FASTPHENO_III_DB_ROOT=~/III_db_final_local
FASTPHENO_PIGMENTS_ROOT=~/III_db_final_local/Pigments

# --- Remote FastPheno source (University of Toronto) ---
# SSH: ssh YOUR_UTORID@ffgg-fastpheno2.utm.utoronto.ca
FASTPHENO_REMOTE_HOST=ffgg-fastpheno2.utm.utoronto.ca
FASTPHENO_REMOTE_PORT=22
FASTPHENO_REMOTE_USER=
FASTPHENO_REMOTE_PASSWORD=

# Absolute path on the server (e.g. /data/FastPheno)
FASTPHENO_REMOTE_III_DB_PATH=/data/FastPheno/III_db_final

# Only these top-level folders are downloaded (not the entire remote tree, add more if needed)
FASTPHENO_SYNC_FOLDERS=Weather,Fluorescence,Reflectance,UAV-Reflectance,UAV-SpatialInformation,SoilMoisture,PredawnWaterPotential,Pigments

# Optional: SSH private key instead of password
# FASTPHENO_REMOTE_SSH_KEY=~/.ssh/id_ed25519

# --- API / auth (optional; not required for data sync) ---
# FASTPHENO_BASE_URL=http://localhost:8000
# FASTPHENO_SECRET_KEY=
# FASTPHENO_ALLOWED_EMAILS=you@utoronto.ca
# FASTPHENO_PIN_MINUTES=15
# FASTPHENO_DEV_PRINT_PINS=1

# SMTP (only if email PIN login is enabled)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=1
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=FastPheno <you@example.com>
